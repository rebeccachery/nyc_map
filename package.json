    "maplibre-gl": "^5.24.0",
    "next": "16.2.6",
    "plotly.js-dist-min": "^2.35.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.2.6",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
