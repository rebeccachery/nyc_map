# Census Bureau Data API key (required for demographics layers)
# Request a free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional: NYC Open Data SODA app token (higher rate limits)
# NEXT_PUBLIC_NYC_SODA_APP_TOKEN=

# Anthropic API key for ask-the-map (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional: basemap style (any MapLibre style JSON URL). Default is OpenFreeMap positron, no key needed.
# NEXT_PUBLIC_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json?key=YOUR_CARTO_KEY
# NEXT_PUBLIC_BASEMAP_ATTRIBUTION=© CARTO © OpenStreetMap contributors

# Optional: MTA API key for realtime subway positions (NYC map)
# MTA_API_KEY=

# Usage limits for ask-the-map (defaults shown). Spend is estimated from list prices, per UTC day.
# ASK_DAILY_BUDGET_USD=5
# ASK_PER_IP_PER_DAY=100
# ASK_PER_IP_PER_MINUTE=20
# Let requests pick a non-default model (e.g. Sonnet). Off by default so visitors can't raise costs.
# ASK_ALLOW_MODEL_CHOICE=false

# Optional: shared counters so limits hold across Vercel instances. Add Upstash Redis from the
# Vercel Marketplace (it sets KV_REST_API_URL/KV_REST_API_TOKEN), or set these directly:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
