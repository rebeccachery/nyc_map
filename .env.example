# Census Bureau Data API key (required for demographics layers)
# Request a free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional: NYC Open Data SODA app token (higher rate limits)
# NEXT_PUBLIC_NYC_SODA_APP_TOKEN=

# Anthropic API key for ask-the-map (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional: basemap style (any MapLibre style JSON URL). Default is OpenFreeMap positron, no key needed.
# NEXT_PUBLIC_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json?key=YOUR_CARTO_KEY
# NEXT_PUBLIC_BASEMAP_ATTRIBUTION=© CARTO © OpenStreetMap contributors
